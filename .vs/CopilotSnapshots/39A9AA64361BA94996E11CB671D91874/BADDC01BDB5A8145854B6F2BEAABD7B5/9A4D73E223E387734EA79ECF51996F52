@{
}

@using System.Linq
@model IEnumerable<NetCoreMVCLAB5.Models.Account>

<h2>Accounts</h2>

@if (Model == null || !Model.Any())
{
    <p>No accounts available.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Full Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Address</th>
                <th>Birthday</th>
                <th>Gender</th>
                <th>Facebook</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var acct in Model)
        {
            <tr>
                <td>@acct.Id</td>
                <td>@acct.FullName</td>
                <td>@acct.Email</td>
                <td>@acct.Phone</td>
                <td>@acct.Address</td>
                <td>@acct.Birthday.ToShortDateString()</td>
                <td>@acct.Gender</td>
                <td>
                    @if (!string.IsNullOrEmpty(acct.Facebook))
                    {
                        <a href="@acct.Facebook" target="_blank">Profile</a>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
}
