<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin cPanel</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    @await RenderSectionAsync("Css", required: false)
</head>
<body>
    <nav class="navbar navbar-expand navbar-dark bg-dark mb-3">
        <div class="container">
            <ul class="navbar-nav">
                <!-- Tạo thêm DashboardController để đặt link cho menu đầu tiên, xem các bước trong lab này -->
                <li class="nav-item"><a class="nav-link" asp-area="Admins" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
            </ul>
        </div>
    </nav>
    <div class="container">
        @RenderBody()
    </div>
    <script src="~/lib/jquery/dist/jquery.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
