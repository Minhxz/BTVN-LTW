@model Student
@{
    ViewData["Title"] = "Thêm sinh viên";
}

<div class="page-heading">
    <div>
        <p class="page-kicker">Lab 2 · Lesson 10</p>
        <h1>Thêm sinh viên</h1>
        <p class="text-muted mb-0">Nhập thông tin để thêm sinh viên vào danh sách.</p>
    </div>
    <a asp-route="StudentList" class="btn btn-outline-secondary">Về danh sách</a>
</div>

<div class="student-form-panel">
    @* Cách đang dùng: Form Tag Helper theo tên controller và action; tự sinh mã chống giả mạo. *@
    @* HTML thuần tương đương: <form action="/Admin/Student/Add" method="post" enctype="multipart/form-data"> kèm @Html.AntiForgeryToken(). *@
    @* Tag Helper theo tên route tương đương: <form asp-route="StudentAdd" method="post" enctype="multipart/form-data">. *@
    <form asp-controller="Student" asp-action="Create" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <p class="small text-muted mb-4">Các trường có dấu <span class="text-danger">*</span> là bắt buộc.</p>

        <div class="row g-4">
            <div class="col-md-6">
                <label asp-for="Name" class="form-label">Họ tên <span class="text-danger">*</span></label>
                <input asp-for="Name" class="form-control" placeholder="Nhập họ tên" autocomplete="name" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Email" class="form-label">Email <span class="text-danger">*</span></label>
                <input asp-for="Email" type="email" class="form-control" placeholder="sinhvien@example.com" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Password" class="form-label">Mật khẩu <span class="text-danger">*</span></label>
                <input asp-for="Password" type="password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="DateOfBorth" class="form-label">Ngày sinh <span class="text-danger">*</span></label>
                <input asp-for="DateOfBorth" type="date" value="@(Model.DateOfBorth == default ? "" : Model.DateOfBorth.ToString("yyyy-MM-dd"))" class="form-control" />
                <span asp-validation-for="DateOfBorth" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Branch" class="form-label">Ngành học <span class="text-danger">*</span></label>
                <select asp-for="Branch" asp-items="ViewBag.AllBranches" class="form-select">
                    <option value="">-- Chọn ngành học --</option>
                </select>
                <span asp-validation-for="Branch" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <fieldset>
                    <legend class="form-label">Giới tính <span class="text-danger">*</span></legend>
                    <div class="gender-options">
                        @foreach (Gender gender in ViewBag.AllGenders)
                        {
                            var genderId = $"Gender_{gender}";
                            <div class="form-check form-check-inline">
                                <input asp-for="Gender" type="radio" value="@gender" id="@genderId" class="form-check-input" />
                                <label for="@genderId" class="form-check-label">@(gender == Gender.Male ? "Nam" : "Nữ")</label>
                            </div>
                        }
                    </div>
                    <span asp-validation-for="Gender" class="text-danger small"></span>
                </fieldset>
            </div>
            <div class="col-12">
                <label asp-for="Address" class="form-label">Địa chỉ <span class="text-danger">*</span></label>
                <textarea asp-for="Address" class="form-control" rows="2" placeholder="Nhập địa chỉ"></textarea>
                <span asp-validation-for="Address" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label for="avatar" class="form-label">Ảnh đại diện</label>
                <input type="file" name="avatar" id="avatar" class="form-control" accept="image/jpeg,image/png,image/gif,image/webp" aria-describedby="avatar-help" />
                <div id="avatar-help" class="form-text">Ảnh JPG, PNG, GIF hoặc WEBP, tối đa 2 MB. Có thể để trống.</div>
                @Html.ValidationMessage("avatar", "", new { @class = "text-danger small" })
            </div>
            <div class="col-md-6 d-flex align-items-center">
                <div>
                    <div class="form-check">
                        <input asp-for="IsRegular" class="form-check-input" />
                        <label asp-for="IsRegular" class="form-check-label">Sinh viên hệ chính quy</label>
                    </div>
                    <p class="form-text mb-0">Bỏ chọn nếu học hệ phi chính quy.</p>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2 mt-4 pt-3 border-top">
            <button type="submit" class="btn btn-primary">Thêm sinh viên</button>
            <a asp-route="StudentList" class="btn btn-outline-secondary">Hủy</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
