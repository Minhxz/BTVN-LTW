@model IEnumerable<MenuItem>
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}
<nav class="sb-sidenav accordion sb-sidenav-dark" aria-label="Menu chính">
    <div class="sb-sidenav-menu">
        <div class="nav">
            <div class="sb-sidenav-menu-heading">Tổng quan</div>
            <a class="nav-link @(currentController == "Home" ? "active" : "")"
               asp-controller="Home" asp-action="Index">
                <span class="sb-nav-link-icon" aria-hidden="true">⌂</span>
                Trang chủ
            </a>

            <div class="sb-sidenav-menu-heading">Quản lý</div>
            @foreach (var item in Model)
            {
                if (item.Link == "#")
                {
                    <span class="nav-link disabled" aria-disabled="true" title="Chưa có chức năng này">
                        <span class="sb-nav-link-icon" aria-hidden="true">›</span>
                        @item.Name
                    </span>
                }
                else
                {
                    <a class="nav-link @(currentController == "Student" ? "active" : "")"
                       href="@Url.Content(item.Link)">
                        <span class="sb-nav-link-icon" aria-hidden="true">›</span>
                        @item.Name
                    </a>
                }
            }
        </div>
    </div>
    <div class="sb-sidenav-footer">
        <div class="small">Bài thực hành 2</div>
        ASP.NET Core MVC
    </div>
</nav>
