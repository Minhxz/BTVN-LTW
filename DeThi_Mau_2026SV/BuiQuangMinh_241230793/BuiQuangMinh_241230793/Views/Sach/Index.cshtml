@model IEnumerable<BuiQuangMinh_241230793.Models.Sach>

@{
    ViewData["Title"] = "Trang chủ";
}

<div class="banner">
    <img src="~/images/banner.jpg" alt="Banner BookHub" />
</div>

<div id="mainContent">
    <partial name="BuiQuangMinh_241230793_MainContent" model="Model" />
</div>

@section Scripts {
    <script>
        $(function () {
            $('.the-loai').click(function (event) {
                event.preventDefault();

                var lienKet = $(this);

                $.ajax({
                    url: '@Url.Action("RenderByID", "Sach")',
                    type: 'GET',
                    data: { id: lienKet.data('id') },

                    success: function (data) {
                        $('#mainContent').html(data);

                        $('.menu li').removeClass('active');
                        lienKet.parent().addClass('active');
                    },

                    error: function () {
                        alert('Không tải được danh sách sách.');
                    }
                });
            });
        });
    </script>
}
