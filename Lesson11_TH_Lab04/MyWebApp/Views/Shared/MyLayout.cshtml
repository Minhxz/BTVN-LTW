<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Management System</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
</head>
<body class="d-flex flex-column min-vh-100">
    <nav class="navbar navbar-dark bg-dark px-3">
        <a class="navbar-brand" asp-controller="Learner" asp-action="Index">Management System</a>
    </nav>

    <div class="d-flex flex-grow-1">
        <aside class="bg-dark text-white p-3" style="width:210px">
            <div class="text-secondary small text-uppercase">Core</div>
            <a class="d-block text-white-50 text-decoration-none py-1" asp-controller="Learner" asp-action="Index">Dashboard</a>
            <div class="text-secondary small text-uppercase mt-3">Addons</div>
            <a class="d-block text-white-50 text-decoration-none py-1" asp-controller="Learner" asp-action="Index">Learners</a>
        </aside>

        <main class="flex-grow-1 p-3">
            @RenderBody()
        </main>
    </div>

    <footer class="bg-light border-top px-3 py-2 small text-muted">Copyright &copy; 2026</footer>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
