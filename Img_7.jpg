@model IEnumerable<BuiQuangMinh_241230793.Models.Sach>

<div class="section-head">
    <h3>@ViewBag.TieuDe</h3>
</div>
<div class="section-head">
    <h3>@ViewBag.TieuDe</h3>
    <a asp-controller="Sach" asp-action="Create">Thêm sách mới</a>
</div>

<div class="grid">
    @foreach (var item in Model)
    {
        <div class="book-card">
            <a href="#">
                <img src="~/images/@item.Anh" alt="@item.TenSach" />
            </a>

            <h2>@item.TenSach</h2>

            <div class="book-foot">
                <span class="price">@item.Gia</span>
                <button class="btn-buy" type="button">
                    Thêm vào giỏ
                </button>
            </div>
        </div>
    }
</div>

@if (!Model.Any())
{
    <p>Chưa có sách phù hợp.</p>
}
