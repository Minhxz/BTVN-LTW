@model BùiQuangMinh_241230793.Models.TaiSan

@{
    ViewData["Title"] = "Thêm tài sản";
}

<main class="main">
    <div class="container">
        <div class="section-head">
            <h3>BùiQuangMinh-241230793 - Thêm tài sản mới</h3>
        </div>

        <form asp-controller="TaiSan"
              asp-action="Create"
              method="post">

            <div asp-validation-summary="ModelOnly"
                 style="color:red"></div>

            <p>
                <label asp-for="MaLoai">Loại tài sản</label><br />
                <select asp-for="MaLoai"
                        asp-items="ViewBag.MaLoai"></select>
                <span asp-validation-for="MaLoai"
                      style="color:red"></span>
            </p>

            <p>
                <label asp-for="TenTS">Tên tài sản</label><br />
                <input asp-for="TenTS" />
                <span asp-validation-for="TenTS"
                      style="color:red"></span>
            </p>

            <p>
                <label asp-for="NguyenGia">Nguyên giá (triệu đồng)</label><br />
                <input asp-for="NguyenGia" type="text" />
                <span asp-validation-for="NguyenGia"
                      style="color:red"></span>
            </p>

            <p>
                <label asp-for="Anh">Tên file ảnh</label><br />
                <input asp-for="Anh" />
                <span asp-validation-for="Anh"
                      style="color:red"></span>
            </p>

            <button class="btn-buy" type="submit">Create</button>

            <a asp-controller="TaiSan" asp-action="Index">
                Về trang chủ
            </a>
        </form>
    </div>
</main>