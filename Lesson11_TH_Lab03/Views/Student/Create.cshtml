@model Student
@{
    ViewData["Title"] = "Thêm sinh viên";
    var genders = (IEnumerable<Gender>)ViewBag.AllGenders;
}

<h2>Thêm sinh viên</h2>

<div asp-validation-summary="All" class="text-danger"></div>

<form asp-controller="Student" asp-action="Create" method="post" class="mt-3">

    <div style="margin-top:7px" class="form-group row">
        <label asp-for="Name" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="Name" class="form-control" placeholder="Họ tên" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
    </div>

    <div style="margin-top:7px" class="form-group row">
        <label asp-for="Email" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="Email" class="form-control" placeholder="example@gmail.com" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
    </div>

    <div style="margin-top:7px" class="form-group row">
        <label asp-for="Password" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="Password" class="form-control" placeholder="Tối thiểu 8 ký tự, gồm hoa, thường, số, ký tự đặc biệt" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>
    </div>

    <div style="margin-top:7px" class="form-group row">
        <label asp-for="Branch" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <select asp-for="Branch" class="form-select" asp-items="Html.GetEnumSelectList<Branch>()">
                <option value="">-- Chọn ngành học --</option>
            </select>
            <span asp-validation-for="Branch" class="text-danger"></span>
        </div>
    </div>

    <div style="margin-top:7px" class="form-group row">
        <label asp-for="IsRegular" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10 pt-2">
            <input type="checkbox" class="form-check-input" asp-for="IsRegular" />
            <span asp-validation-for="IsRegular" class="text-danger"></span>
        </div>
    </div>

    <div style="margin-top:7px" class="form-group row">
        <label asp-for="DateOfBorth" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="DateOfBorth" class="form-control" />
            <span asp-validation-for="DateOfBorth" class="text-danger"></span>
        </div>
    </div>

    <div style="margin-top:7px" class="form-group row">
        <label asp-for="Score" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="Score" type="text" class="form-control" placeholder="Từ 0.0 đến 10.0" />
            <span asp-validation-for="Score" class="text-danger"></span>
        </div>
    </div>

    <div style="margin-top:7px" class="form-group row">
        <label asp-for="Gender" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10 pt-2">
            @foreach (var g in genders)
            {
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" asp-for="Gender" value="@g" id="Gender@(g)" />
                    <label class="form-check-label" for="Gender@(g)">@g.GetDisplayName()</label>
                </div>
            }
            <div><span asp-validation-for="Gender" class="text-danger"></span></div>
        </div>
    </div>

    <div style="margin-top:7px" class="form-group row">
        <label asp-for="Address" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <textarea asp-for="Address" class="form-control" placeholder="Địa chỉ"></textarea>
            <span asp-validation-for="Address" class="text-danger"></span>
        </div>
    </div>

    <div style="margin-top:10px" class="form-group row">
        <div class="col-sm-10 offset-sm-2">
            <button type="submit" class="btn btn-primary">Thêm</button>
            <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
        </div>
    </div>
</form>
