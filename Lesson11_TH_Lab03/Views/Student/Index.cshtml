@model IEnumerable<Student>
@{
    ViewData["Title"] = "Danh sách sinh viên";
}

<h2>Danh sách sinh viên</h2>

<table class="table table-striped table-bordered mt-3">
    <thead class="table-dark">
        <tr>
            <th>Mã</th>
            <th>Họ tên</th>
            <th>Email</th>
            <th>Ngành học</th>
            <th>Giới tính</th>
            <th>Hệ</th>
            <th>Ngày sinh</th>
            <th>Điểm</th>
            <th>Địa chỉ</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.Id</td>
                <td>@s.Name</td>
                <td>@s.Email</td>
                <td>@s.Branch?.GetDisplayName()</td>
                <td>@s.Gender?.GetDisplayName()</td>
                <td>@(s.IsRegular ? "Chính quy" : "Phi chính quy")</td>
                <td>@s.DateOfBorth?.ToString("dd/MM/yyyy")</td>
                <td>@s.Score</td>
                <td>@s.Address</td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Create" class="btn btn-primary">Thêm sinh viên</a>
